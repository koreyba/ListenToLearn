{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "listen-to-learn",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
    "ACCESS_AUD": "315a0118e28bc19c5d5cc5298a8fb4704ad351ebe58774f9966cd678458d8ff0"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listen-to-learn-db",
      "database_id": "27fe4c19-48ce-4047-b5d5-f486cb9dc23c",
      "migrations_dir": "./drizzle"
    }
  ],
  "env": {
    "preview": {
      "name": "listen-to-learn-preview",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
        "ACCESS_AUD": "315a0118e28bc19c5d5cc5298a8fb4704ad351ebe58774f9966cd678458d8ff0,c3e7906e8ce42cf58b85e2c72d27df691fdb0fec681cedd8093ada530e9c2518"
      },
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "listen-to-learn-preview-db",
          "database_id": "2c137ca2-8b12-498f-98df-127eaa39e6d8",
          "migrations_dir": "./drizzle"
        }
      ]
    }
  }
}
