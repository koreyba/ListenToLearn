{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unmumble-prod",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "unmumble.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
    "ACCESS_AUD": "9b29b79b8bca8308e4933c030f464d5a1da798497182652fe75a1fd304975a29"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unmumble-prod-db",
      "database_id": "9e187b50-9012-45d9-aeec-40a573e59d79",
      "migrations_dir": "./drizzle"
    }
  ],
  "env": {
    "preview": {
      "name": "unmumble-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
        "ACCESS_AUD": "85d7b3fcc999788239cf6f922a2bcf6b63be99dd2e05df2af5e66e7645bea1a4"
      },
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unmumble-preview-db",
          "database_id": "0d361b44-60ef-4c5b-b2ea-fe9d4d5020f1",
          "migrations_dir": "./drizzle"
        }
      ]
    }
  }
}
