{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unmumble-preview",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
    "ACCESS_AUD": "85d7b3fcc999788239cf6f922a2bcf6b63be99dd2e05df2af5e66e7645bea1a4"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unmumble-preview-db",
      "database_id": "0d361b44-60ef-4c5b-b2ea-fe9d4d5020f1",
      "migrations_dir": "./drizzle"
    }
  ]
}
