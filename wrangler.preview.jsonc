{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unmumble-preview",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
    "ACCESS_AUD": "85d7b3fcc999788239cf6f922a2bcf6b63be99dd2e05df2af5e66e7645bea1a4",
    "OPENROUTER_MODEL": "deepseek/deepseek-v4-flash-0731"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "AI_CHAT_USER_RATE_LIMITER",
      "namespace_id": "311001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AI_CHAT_EDGE_AGGREGATE_RATE_LIMITER",
      "namespace_id": "311002",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unmumble-preview-db",
      "database_id": "0d361b44-60ef-4c5b-b2ea-fe9d4d5020f1",
      "migrations_dir": "./drizzle"
    }
  ]
}
