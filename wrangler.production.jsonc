{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "listen-to-learn",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "listen-to-learn-koreyba.cloudflareaccess.com",
    "ACCESS_AUD": "315a0118e28bc19c5d5cc5298a8fb4704ad351ebe58774f9966cd678458d8ff0"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listen-to-learn-db",
      "database_id": "27fe4c19-48ce-4047-b5d5-f486cb9dc23c",
      "migrations_dir": "./drizzle"
    }
  ]
}
